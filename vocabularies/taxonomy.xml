                    <category xml:id="semissalis">
                        <catDesc>
                            <term xml:lang="la">semissalis</term>
                            <gloss xml:lang="en">Late Roman military rank; received 1 capitum (fodder ration, indicating mounted service) and 1½ annonae (one and a half food rations). Function unclear; attested in African and Sardinian ducal officia</gloss>
