                    <category xml:id="org-ecclesia">
                        <catDesc>
                            <term xml:lang="la">ecclesia</term>
                            <gloss xml:lang="en">A Christian church as an institution, named in an inscription as recipient, guardian or addressee.</gloss>
                        </catDesc>
                    </category>
                    <category xml:id="org-schola">
                        <catDesc>
                            <term xml:lang="la">schola</term>
