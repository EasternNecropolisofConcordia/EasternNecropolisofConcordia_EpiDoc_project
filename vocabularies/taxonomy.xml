                <taxonomy xml:id="sanctions">
                    <category xml:id="poena">
                        <catDesc>
                            <term xml:lang="la">poena</term>
                            <term xml:lang="it">sanzione sepolcrale</term>
                            <gloss xml:lang="en">A penalty threatened against violation of the tomb. An inscription declares the kinds of penalty it threatens with a catRef in profileDesc; the amount of a fine is marked in the edition with measure.</gloss>
                        </catDesc>
                        <category xml:id="poena-pecuniaria">
                            <catDesc>
                                <term xml:lang="la">poena pecuniaria</term>
                                <gloss xml:lang="en">A fine, payable to a named recipient.</gloss>
                            </catDesc>
                        </category>
                        <category xml:id="poena-corporalis">
                            <catDesc>
                                <term xml:lang="la">poena corporalis</term>
                                <gloss xml:lang="en">A bodily penalty imposed by law, as distinct from a curse or a divine sanction: Fl. Victurinus, iure ei manus pricidentur. Should a divine or religious sanction be found in the corpus, it is a sibling of this category and not the same thing.</gloss>
                            </catDesc>
                        </category>
                    </category>
                    <category xml:id="poenae-alternativae">
                        <catDesc>
                            <term xml:lang="la">poenae alternativae</term>
                            <gloss xml:lang="en">Two or more penalties offered as alternatives, aut ... aut.</gloss>
                        </catDesc>
                    </category>
                    <category xml:id="poenae-cumulativae">
                        <catDesc>
                            <term xml:lang="la">poenae cumulativae</term>
                            <gloss xml:lang="en">Two or more penalties imposed together.</gloss>
                        </catDesc>
                    </category>
                </taxonomy>
                <taxonomy xml:id="roles">
                    <category xml:id="fine-recipient">
                        <catDesc>
                            <term xml:lang="en">recipient of a fine</term>
                            <gloss xml:lang="en">The party to whom a sepulchral fine is payable. In English because the Latin beneficiarius is a military rank and would collide with the taxonomy of ranks used throughout this corpus.</gloss>
                        </catDesc>
                    </category>
                </taxonomy>
                <taxonomy xml:id="acts">
                    <category xml:id="actus">
                        <catDesc>
                            <term xml:lang="la">actus</term>
                            <gloss xml:lang="en">An act that the text attributes to a named party. What is recorded is the act the text states, not the transaction the editor reconstructs behind it.</gloss>
                        </catDesc>
                        <category xml:id="actus-sepulcri">
                            <catDesc>
                                <term xml:lang="la">actus sepulcri</term>
                                <gloss xml:lang="en">Providing, making, setting up or renewing the tomb.</gloss>
                            </catDesc>
                            <category xml:id="emo">
                                <catDesc>
                                    <term xml:lang="la">emo</term>
                                    <gloss xml:lang="en">To buy. Active emit; also passive empta est, where the tomb is the subject and the buyer may be left unexpressed.</gloss>
                                </catDesc>
                            </category>
                            <category xml:id="comparo">
                                <catDesc>
                                    <term xml:lang="la">comparo</term>
                                    <gloss xml:lang="en">To procure, obtain by purchase: comparavit.</gloss>
                                </catDesc>
                            </category>
                            <category xml:id="facio">
                                <catDesc>
                                    <term xml:lang="la">facio</term>
                                    <gloss xml:lang="en">To make or have made: fecit.</gloss>
                                </catDesc>
                            </category>
                            <category xml:id="pono">
                                <catDesc>
                                    <term xml:lang="la">pono</term>
                                    <gloss xml:lang="en">To set up: posuit. The passive positus est shares this lemma but states a different act, the laying of the deceased, with the deceased as subject; the two are told apart by the direction of the relation, not by the lemma.</gloss>
                                </catDesc>
                            </category>
                            <category xml:id="renovo">
                                <catDesc>
                                    <term xml:lang="la">renovo</term>
                                    <gloss xml:lang="en">To renew or restore an existing monument: renovavit.</gloss>
                                </catDesc>
                            </category>
                            <category xml:id="confero">
                                <catDesc>
                                    <term xml:lang="la">confero</term>
                                    <gloss xml:lang="en">To contribute: contulit, Fl. Maximinus.</gloss>
                                </catDesc>
                            </category>
                        </category>
                        <category xml:id="actus-tutelae">
                            <catDesc>
                                <term xml:lang="la">actus tutelae</term>
                                <gloss xml:lang="en">Placing the tomb under the protection of a third party. Distinct from providing it.</gloss>
                            </catDesc>
                            <category xml:id="commendo">
                                <catDesc>
                                    <term xml:lang="la">commendo</term>
                                    <gloss xml:lang="en">To entrust: commendamus, the Flavii Servilii, who entrust the sarcophagus to the church of Concordia.</gloss>
                                </catDesc>
                            </category>
                        </category>
                        <category xml:id="act-unexpressed">
                            <catDesc>
                                <term xml:lang="en">act not expressed</term>
                                <gloss xml:lang="en">The text names the parties but no verb states what was done, most often a dedication with the deceased in the dative. Recorded explicitly rather than by leaving ana off, so that a text which says nothing can be told apart from one not yet encoded. In English because Latin supplies no received term for this and the project does not coin them.</gloss>
                            </catDesc>
                        </category>
                    </category>
                </taxonomy>
            </classDecl>
            <unitDecl>
                <!-- Units of weight. The metal is not part of the unit: it is carried by
                     @commodity on the measure, whose values in this corpus are aurum and
                     argentum. No conversion is declared between the two metals, because the
                     late antique ratio is a scholarly argument and does not belong in a
                     declaration. -->
                <unitDef xml:id="libra" type="weight">
                    <label>libra</label>
                    <gloss xml:lang="en">The Roman pound.</gloss>
                    <conversion fromUnit="#uncia" toUnit="#libra" formula="$fromUnit div 12"/>
                </unitDef>
                <unitDef xml:id="uncia" type="weight">
                    <label>uncia</label>
                    <gloss xml:lang="en">One twelfth of a libra.</gloss>
                </unitDef>
                <!-- Denominations. These name a coin, not a quantity of metal, so they take
                     no @commodity. -->
                <unitDef xml:id="solidus" type="currency">
                    <label>solidus</label>
                    <gloss xml:lang="en">The late Roman gold coin, struck at seventy-two to the libra of gold. The conversion below records that mint standard; it says nothing about the weight of any coin actually paid.</gloss>
                    <conversion fromUnit="#solidus" toUnit="#libra" formula="$fromUnit div 72"/>
                </unitDef>
                <unitDef xml:id="follis" type="currency">
                    <label>follis</label>
                    <gloss xml:lang="en">No conversion is declared. The term covers a bronze coin, a sealed bag of coin and a unit of account, and its value against the gold coinage moved with the currency; any equivalence would be an argument, not a fact.</gloss>
                </unitDef>
                <unitDef xml:id="sestertius" type="currency">
                    <label>sestertius</label>
                    <gloss xml:lang="en">No conversion is declared. In late antique funerary sanctions the denomination is largely formulaic and bears no stable relation to the contemporary coinage.</gloss>
                </unitDef>
            </unitDecl>
        </encodingDesc>
